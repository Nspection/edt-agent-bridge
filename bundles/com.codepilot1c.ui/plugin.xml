<?xml version="1.0" encoding="UTF-8"?>
<plugin>
 <extension point="org.eclipse.ui.preferencePages"><page id="com.codepilot1c.ui.bridge.connection" name="EDT Agent Bridge" class="com.codepilot1c.ui.bridge.BridgePreferencePage"/></extension>
 <extension point="org.eclipse.ui.startup"><startup class="com.codepilot1c.ui.startup.McpHostStartup"/></extension>
 <extension point="org.eclipse.ui.editors"><editor id="com.codepilot1c.ui.spreadsheetMerge" name="Табличное объединение" class="com.codepilot1c.ui.bridge.SpreadsheetMergeEditor"/></extension>
 <extension point="org.eclipse.ui.views">
  <category id="com.codepilot1c.ui.views.bridge" name="EDT Agent Bridge"/>
  <view id="com.codepilot1c.ui.views.agentChanges" name="Изменения ИИ"
        category="com.codepilot1c.ui.views.bridge" icon="resources/icons/agent-changes.png"
        class="com.codepilot1c.ui.bridge.AgentChangesView"/>
  <view id="com.codepilot1c.ui.views.agentMessages" name="Сообщения ИИ"
        category="com.codepilot1c.ui.views.bridge" icon="resources/icons/agent-messages.png"
        class="com.codepilot1c.ui.bridge.AgentMessagesView"/>
 </extension>
 <extension point="org.eclipse.ui.perspectiveExtensions">
  <perspectiveExtension targetID="com._1c.g5.v8.dt.ui2.perspective">
   <viewShortcut id="com.codepilot1c.ui.views.agentChanges"/>
   <viewShortcut id="com.codepilot1c.ui.views.agentMessages"/>
   <view id="com.codepilot1c.ui.views.agentChanges" relative="org.eclipse.ui.editorss"
         relationship="right" ratio="0.25" minimized="true"/>
   <view id="com.codepilot1c.ui.views.agentMessages" relative="com.codepilot1c.ui.views.agentChanges"
         relationship="stack" minimized="true"/>
  </perspectiveExtension>
 </extension>
</plugin>
