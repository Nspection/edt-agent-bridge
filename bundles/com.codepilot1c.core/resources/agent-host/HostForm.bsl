&НаКлиенте
Перем КомпонентаАгента;
&НаКлиенте
Перем АгентЗанят;
&НаКлиенте
Перем ОшибкиКанала;

&НаКлиенте
Процедура HostOpen(Отказ)
    HostStage("opening");
    ПутьНастроек = Сред(ПараметрЗапуска, СтрДлина("EDTAgentHost=") + 1);
    Попытка
        Текст = Новый ТекстовыйДокумент;
        Текст.Прочитать(ПутьНастроек, КодировкаТекста.UTF8);
        НастройкиАгента = HostReadJSON(Текст.ПолучитьТекст());
        Если НастройкиАгента.metadata_form <> "" И __BOOTSTRAP__ Тогда
            ОткрытьФорму(НастройкиАгента.metadata_form);
            Закрыть();
            Возврат;
        КонецЕсли;
        HostStage("attaching_component");
        АдресКомпоненты = HostComponentAddress(Новый ДвоичныеДанные(НастройкиАгента.native_path), УникальныйИдентификатор);
        Если Не ПодключитьВнешнююКомпоненту(АдресКомпоненты, "BridgeAgent", ТипВнешнейКомпоненты.Native) Тогда
            ВызватьИсключение "Native component connection failed";
        КонецЕсли;
        КомпонентаАгента = Новый("AddIn.BridgeAgent.AgentHost");
        HostStage("configuring_channel");
        КомпонентаАгента.Configure(Строка(НастройкиАгента.port), НастройкиАгента.token);
        ДанныеСеанса = HostInfo();
        АгентЗанят = Ложь;
        ОшибкиКанала = 0;
        ПодключитьОбработчикОжидания("HostTick", 1);
        КомпонентаАгента.Hello(HostWriteJSON(ДанныеСеанса));
        HostStage("ready");
    Исключение
        HostStage("initialization_failed");
        Сообщить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
КонецПроцедуры

&НаСервереБезКонтекста
Функция HostInfo()
    Система = Новый СистемнаяИнформация;
    Возврат Новый Структура("configuration,user,platform", Метаданные.Имя, ИмяПользователя(), Система.ВерсияПриложения);
КонецФункции

&НаКлиенте
Процедура HostTick() Экспорт
    Если АгентЗанят Тогда Возврат; КонецЕсли;
    АгентЗанят = Истина;
    Попытка
        ЗаданиеАгента = HostReadJSON(КомпонентаАгента.Poll());
        ОшибкиКанала = 0;
        Остановить = Ложь;
        Если ЗаданиеАгента.Свойство("stop", Остановить) И Остановить Тогда
            ОтключитьОбработчикОжидания("HostTick");
            КомпонентаАгента.Stop();
            ЗавершитьРаботуСистемы(Ложь);
            Возврат;
        КонецЕсли;
        ИдентификаторЗадания = "";
        Если ЗаданиеАгента.Свойство("request_id", ИдентификаторЗадания) Тогда
            Если ЗаданиеАгента.context = "server" Тогда
                РезультатJSON = HostExecuteServer(HostWriteJSON(ЗаданиеАгента));
            Иначе
                РезультатJSON = HostExecuteClient(ЗаданиеАгента);
            КонецЕсли;
            КомпонентаАгента.Complete(РезультатJSON);
        КонецЕсли;
    Исключение
        ОшибкиКанала = ОшибкиКанала + 1;
        Если ОшибкиКанала >= 3 Тогда
            ОтключитьОбработчикОжидания("HostTick");
            Сообщить("EDT Agent Host: канал остановлен; исход последнего задания проверяйте через MCP.");
        КонецЕсли;
    КонецПопытки;
    АгентЗанят = Ложь;
КонецПроцедуры

&НаКлиенте
Функция HostExecuteClient(ЗаданиеАгента)
    Ответ = Новый Структура("request_id,success", ЗаданиеАгента.request_id, Ложь);
    Попытка
        ПараметрыВызова = ЗаданиеАгента.parameters;
        Результат = Неопределено;
        Выполнить(ЗаданиеАгента.code);
        Ответ.Вставить("value", Результат);
        Ответ.success = Истина;
        Возврат HostWriteJSON(Ответ);
    Исключение
        Ответ.success = Ложь;
        Ответ.Удалить("value");
        Ответ.Вставить("error", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
        Возврат HostWriteJSON(Ответ);
    КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция HostExecuteServer(ТекстЗадания)
    ЗаданиеАгента = HostReadJSON(ТекстЗадания);
    Ответ = Новый Структура("request_id,success", ЗаданиеАгента.request_id, Ложь);
    Попытка
        ПараметрыВызова = ЗаданиеАгента.parameters;
        Результат = Неопределено;
        Выполнить(ЗаданиеАгента.code);
        Ответ.Вставить("value", Результат);
        Ответ.success = Истина;
        Возврат HostWriteJSON(Ответ);
    Исключение
        Ответ.success = Ложь;
        Ответ.Удалить("value");
        Ответ.Вставить("error", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
        Возврат HostWriteJSON(Ответ);
    КонецПопытки;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция HostReadJSON(ТекстJSON)
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(ТекстJSON);
    ЗначениеJSON = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат ЗначениеJSON;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция HostWriteJSON(ЗначениеJSON)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, ЗначениеJSON);
    Возврат Запись.Закрыть();
КонецФункции

&НаСервереБезКонтекста
Функция HostComponentAddress(ДанныеКомпоненты, ВладелецХранилища)
    Возврат ПоместитьВоВременноеХранилище(ДанныеКомпоненты, ВладелецХранилища);
КонецФункции

&НаКлиенте
Процедура HostStage(Этап)
    ТекстЭтапа = Новый ТекстовыйДокумент;
    ТекстЭтапа.УстановитьТекст(Этап);
    ТекстЭтапа.Записать(Сред(ПараметрЗапуска, СтрДлина("EDTAgentHost=") + 1) + ".stage", КодировкаТекста.UTF8);
КонецПроцедуры
