#Область ОписаниеПеременных

&НаКлиенте
Перем КомпонентаАгента;
&НаКлиенте
Перем АгентЗанят;
&НаКлиенте
Перем ОшибкиКанала;

&НаКлиенте
Перем АгентПакет;
&НаКлиенте
Перем АгентШаг;
&НаКлиенте
Перем АгентРезультаты;
&НаКлиенте
Перем АгентСнимокОжидает;
&НаКлиенте
Перем АгентОтветПакета;
&НаКлиенте
Перем АгентПрогресс;
&НаКлиенте
Перем АгентПоследовательность;
&НаКлиенте
Перем АгентНачалоШага;
&НаКлиенте
Перем АгентСледующаяПроверка;
&НаКлиенте
Перем АгентПопытки;
&НаКлиенте
Перем АгентОшибкаПакета;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура HostOpen(Отказ)

    HostStage("opening");
    ПутьНастроек = Сред(ПараметрЗапуска, СтрДлина("EDTAgentHost=") + 1);
    Попытка
        Текст = Новый ТекстовыйДокумент;
        Текст.Прочитать(ПутьНастроек, КодировкаТекста.UTF8);
        НастройкиАгента = HostReadJSON(Текст.ПолучитьТекст());
        Если НастройкиАгента.metadata_form <> "" И __BOOTSTRAP__ Тогда
            ОткрытьФорму(НастройкиАгента.metadata_form);
            Закрыть();
            Возврат;
        КонецЕсли;
        HostStage("attaching_component");
        АдресКомпоненты = HostComponentAddress(Новый ДвоичныеДанные(НастройкиАгента.native_path), УникальныйИдентификатор);
        Если Не ПодключитьВнешнююКомпоненту(АдресКомпоненты, "BridgeAgent", ТипВнешнейКомпоненты.Native) Тогда
            ВызватьИсключение "Native component connection failed";
        КонецЕсли;
        КомпонентаАгента = Новый("AddIn.BridgeAgent.AgentHost");
        HostStage("configuring_channel");
        HostRequireNativeReply(КомпонентаАгента.Configure(Строка(НастройкиАгента.port), НастройкиАгента.token), "configured", "Configure");
        ДанныеСеанса = HostInfo();
        ДанныеСеанса.Вставить("form", ЭтаФорма.ИмяФормы);
        ДанныеСеанса.Вставить("native_features", Новый Массив);
        ВозможностиОбработки = Новый Массив;
        ВозможностиОбработки.Добавить("batch_controls_v1");
        ДанныеСеанса.Вставить("host_features", ВозможностиОбработки);
        Попытка
            ВозможностиКомпоненты = HostReadJSON(КомпонентаАгента.Capabilities());
            ДанныеСеанса.native_features = ВозможностиКомпоненты.features;
        Исключение
            // Older transport components remain usable without screenshot steps.
        КонецПопытки;
        АгентЗанят = Ложь;
        ОшибкиКанала = 0;
        HostRequireNativeReply(КомпонентаАгента.Hello(HostWriteJSON(ДанныеСеанса)), "{}", "Hello");
        ПодключитьОбработчикОжидания("HostTick", 1);
        HostStage("ready");
    Исключение
        HostStage("initialization_failed");
        Сообщить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура HostRequireNativeReply(Ответ, ОжидаемыйОтвет, Операция)
    Если ТипЗнч(Ответ) <> Тип("Строка") Или Ответ <> ОжидаемыйОтвет Тогда
        ВызватьИсключение "Native host acknowledgement failed: " + Операция;
    КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция HostInfo()
    Система = Новый СистемнаяИнформация;
    Возврат Новый Структура("configuration,user,platform", Метаданные.Имя, ИмяПользователя(), Система.ВерсияПриложения);
КонецФункции

&НаКлиенте
Процедура HostTick() Экспорт

    Если АгентЗанят Тогда Возврат; КонецЕсли;
    АгентЗанят = Истина;
    Попытка
        Если АгентПрогресс <> Неопределено Тогда
            HostRequireNativeReply(КомпонентаАгента.Complete(АгентПрогресс), "{}", "Complete");
            АгентПрогресс = Неопределено;
            ОшибкиКанала = 0;
            АгентЗанят = Ложь;
            Возврат;
        КонецЕсли;
        Если АгентОтветПакета <> Неопределено Тогда
            HostBatchComplete();
            ОшибкиКанала = 0;
            АгентЗанят = Ложь;
            Возврат;
        КонецЕсли;
        Если АгентПакет <> Неопределено Тогда
            СигналКанала = HostReadJSON(КомпонентаАгента.Poll());
            Остановить = Ложь;
            Если СигналКанала.Свойство("stop", Остановить) И Остановить Тогда
                HostStopClient();
                Возврат;
            КонецЕсли;
            HostBatchTick();
            ОшибкиКанала = 0;
            АгентЗанят = Ложь;
            Возврат;
        КонецЕсли;
        ЗаданиеАгента = HostReadJSON(КомпонентаАгента.Poll());
        Остановить = Ложь;
        Если ЗаданиеАгента.Свойство("stop", Остановить) И Остановить Тогда
            HostStopClient();
            Возврат;
        КонецЕсли;
        ИдентификаторЗадания = "";
        Если ЗаданиеАгента.Свойство("request_id", ИдентификаторЗадания) Тогда
            Если ЗаданиеАгента.context = "batch" Тогда
                АгентПакет = ЗаданиеАгента;
                АгентПакет.Вставить("steps", HostReadJSON(ЗаданиеАгента.code).steps);
                АгентШаг = 0;
                АгентРезультаты = Новый Массив;
                АгентСнимокОжидает = Ложь;
                АгентПоследовательность = 0;
                АгентНачалоШага = Неопределено;
                АгентОшибкаПакета = "";
            ИначеЕсли ЗаданиеАгента.context = "server" Тогда
                РезультатJSON = HostExecuteServer(HostWriteJSON(ЗаданиеАгента));
            Иначе
                РезультатJSON = HostExecuteClient(ЗаданиеАгента);
            КонецЕсли;
            Если ЗаданиеАгента.context <> "batch" Тогда
                HostRequireNativeReply(КомпонентаАгента.Complete(РезультатJSON), "{}", "Complete");
            КонецЕсли;
        КонецЕсли;
        ОшибкиКанала = 0;
    Исключение
        ОшибкиКанала = ОшибкиКанала + 1;
        Если ОшибкиКанала >= 3 Тогда
            HostStage("transport_failed");
            ОтключитьОбработчикОжидания("HostTick");
            Сообщить("EDT Agent Host: канал остановлен; исход последнего задания проверяйте через MCP.");
        КонецЕсли;
    КонецПопытки;
    АгентЗанят = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура HostStopClient()
    ОтключитьОбработчикОжидания("HostTick");
    HostRequireNativeReply(КомпонентаАгента.Stop(), "stopped", "Stop");
    ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура HostBatchTick()

    Если АгентСнимокОжидает Тогда
        Попытка
            Снимок = HostReadJSON(КомпонентаАгента.Screenshot());
            Если Не Снимок.Свойство("snapshot_id") Тогда
                ВызватьИсключение НСтр("ru = 'Компонента не вернула описание снимка'; en = 'Native component did not return a snapshot manifest'");
            КонецЕсли;
            АгентРезультаты[АгентРезультаты.Количество() - 1].Вставить("snapshot", Снимок);
        Исключение
            ТекстОшибкиСнимка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
            АгентРезультаты[АгентРезультаты.Количество() - 1].Вставить("snapshot_error", Лев(ТекстОшибкиСнимка, 4096));
            АгентРезультаты[АгентРезультаты.Количество() - 1].Вставить("snapshot_error_truncated", СтрДлина(ТекстОшибкиСнимка) > 4096);
            Если АгентОшибкаПакета = "" Тогда
                АгентОшибкаПакета = НСтр("ru = 'Не удалось получить снимок'; en = 'Screenshot failed'");
            КонецЕсли;
        КонецПопытки;
        АгентСнимокОжидает = Ложь;
        HostBatchProgress(?(АгентОшибкаПакета = "", "step_completed", "step_failed"));
        Возврат;
    КонецЕсли;
    Если АгентОшибкаПакета <> "" Тогда
        HostBatchFinish(Ложь, АгентОшибкаПакета);
        Возврат;
    КонецЕсли;
    Если АгентШаг >= АгентПакет.steps.Количество() Тогда
        HostBatchFinish(Истина, "");
        Возврат;
    КонецЕсли;
    Шаг = АгентПакет.steps[АгентШаг];
    ВидШага = "execute";
    Если Не Шаг.Свойство("kind", ВидШага) Тогда ВидШага = "execute"; КонецЕсли;
    Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
    Если АгентНачалоШага = Неопределено Тогда
        АгентНачалоШага = Сейчас;
        АгентСледующаяПроверка = Сейчас;
        АгентПопытки = 0;
    КонецЕсли;
    Если ВидШага = "wait" И АгентПопытки > 0 И Сейчас - АгентНачалоШага >= Шаг.timeout_ms Тогда
        Ответ = Новый Структура("success,error", Ложь, НСтр("ru = 'Истекло время ожидания условия'; en = 'Condition wait timed out'"));
        Ответ.Вставить("failure_kind", "condition_timeout");
        HostBatchRecord(Шаг, ВидШага, Ответ);
        Возврат;
    КонецЕсли;
    Если ВидШага = "wait" И Сейчас < АгентСледующаяПроверка Тогда
        Возврат;
    КонецЕсли;
    Вызов = Новый Структура("request_id,code", АгентПакет.request_id, Шаг.code);
    Вызов.Вставить("parameters", Шаг.parameters);
    // Only an explicitly declared wait probe can repeat. Changing steps are claimed before RPC.
    АгентПопытки = АгентПопытки + 1;
    Если ВидШага <> "wait" Тогда АгентШаг = АгентШаг + 1; КонецЕсли;
    Попытка
        Если Шаг.context = "server" Тогда
            Ответ = HostReadJSON(HostExecuteServer(HostWriteJSON(Вызов)));
        Иначе
            Ответ = HostReadJSON(HostExecuteClient(Вызов));
        КонецЕсли;
    Исключение
        Если ВидШага = "wait" Тогда АгентШаг = АгентШаг + 1; КонецЕсли;
        Ответ = Новый Структура("success,outcome_unknown", Ложь, Истина);
        Ответ.Вставить("caption", Шаг.caption);
        Ответ.Вставить("step", АгентШаг);
        АгентРезультаты.Добавить(Ответ);
        HostBatchFinish(Ложь, "Step outcome unknown; executed steps must not be replayed", Истина);
        Возврат;
    КонецПопытки;
    Если ВидШага = "wait" И ТекущаяУниверсальнаяДатаВМиллисекундах() - АгентНачалоШага >= Шаг.timeout_ms Тогда
        Ответ.success = Ложь;
        Ответ.Вставить("error", НСтр("ru = 'Проверка завершилась после срока ожидания'; en = 'Probe completed after its deadline'"));
        Ответ.Вставить("failure_kind", "condition_timeout");
    КонецЕсли;
    Если Ответ.success И (ВидШага = "wait" Или ВидШага = "assert") Тогда
        Если ТипЗнч(Ответ.value) <> Тип("Булево") Тогда
            Ответ.success = Ложь;
            Ответ.Вставить("error", НСтр("ru = 'Условие должно вернуть Булево'; en = 'Condition must return Boolean'"));
            Ответ.Вставить("failure_kind", "condition_type");
        ИначеЕсли Не Ответ.value Тогда
            Если ВидШага = "wait" Тогда
                АгентСледующаяПроверка = ТекущаяУниверсальнаяДатаВМиллисекундах() + Шаг.interval_ms;
                HostBatchProgress("waiting");
                Возврат;
            КонецЕсли;
            Ответ.success = Ложь;
            Ответ.Вставить("error", НСтр("ru = 'Проверка условия не пройдена'; en = 'Assertion failed'"));
            Ответ.Вставить("failure_kind", "assertion_failed");
        КонецЕсли;
    КонецЕсли;
    Если ВидШага = "wait" Тогда АгентШаг = АгентШаг + 1; КонецЕсли;
    Если Ответ.success И ВидШага = "read" Тогда
        Попытка
            Ответ.value = HostBatchSelect(Ответ.value, Шаг.select);
        Исключение
            Ответ.success = Ложь;
            Ответ.Удалить("value");
            Ответ.Вставить("error", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
            Ответ.Вставить("failure_kind", "selection_failed");
        КонецПопытки;
    КонецЕсли;
    HostBatchRecord(Шаг, ВидШага, Ответ, Истина);

КонецПроцедуры

&НаКлиенте
Процедура HostBatchRecord(Шаг, ВидШага, Ответ, ШагУчтен = Ложь)

    Если Не ШагУчтен Тогда АгентШаг = АгентШаг + 1; КонецЕсли;
    Ответ.Вставить("caption", Шаг.caption);
    Ответ.Вставить("step", АгентШаг);
    Ответ.Вставить("kind", ВидШага);
    Ответ.Вставить("attempts", АгентПопытки);
    Ответ.Вставить("elapsed_ms", Макс(0, ТекущаяУниверсальнаяДатаВМиллисекундах() - АгентНачалоШага));
    // Bound every persisted step before progress; no mutation is replayed to retrieve omitted data.
    Если Ответ.Свойство("value") И СтрДлина(HostWriteJSON(Ответ.value)) > 16384 Тогда
        Ответ.Удалить("value");
        Ответ.Вставить("value_omitted", Истина);
        Ответ.Вставить("value_limit_chars", 16384);
    КонецЕсли;
    Если Ответ.Свойство("error") И СтрДлина(Ответ.error) > 4096 Тогда
        Ответ.error = Лев(Ответ.error, 4096);
        Ответ.Вставить("error_truncated", Истина);
    КонецЕсли;
    АгентРезультаты.Добавить(Ответ);
    АгентНачалоШага = Неопределено;
    Если Не Ответ.success Тогда
        АгентОшибкаПакета = Ответ.error;
        АгентСнимокОжидает = Ложь;
        Если Не Шаг.Свойство("screenshot_on_failure", АгентСнимокОжидает) Тогда АгентСнимокОжидает = Ложь; КонецЕсли;
    Иначе
        АгентСнимокОжидает = Шаг.screenshot;
    КонецЕсли;
    Если Не АгентСнимокОжидает Тогда
        HostBatchProgress(?(Ответ.success, "step_completed", "step_failed"));
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура HostBatchProgress(Этап)

    АгентПоследовательность = АгентПоследовательность + 1;
    Ответ = Новый Структура("request_id,progress", АгентПакет.request_id, Истина);
    Ответ.Вставить("sequence", АгентПоследовательность);
    Ответ.Вставить("phase", Этап);
    Ответ.Вставить("value", АгентРезультаты);
    Ответ.Вставить("current_step", Мин(АгентШаг + 1, АгентПакет.steps.Количество()));
    Ответ.Вставить("attempts", АгентПопытки);
    Если АгентНачалоШага <> Неопределено Тогда
        Ответ.Вставить("elapsed_ms", Макс(0, ТекущаяУниверсальнаяДатаВМиллисекундах() - АгентНачалоШага));
    КонецЕсли;
    // Freeze before I/O. HostTick retries this acknowledgement, never the business operation.
    АгентПрогресс = HostWriteJSON(Ответ);
    HostRequireNativeReply(КомпонентаАгента.Complete(АгентПрогресс), "{}", "Complete");
    АгентПрогресс = Неопределено;

КонецПроцедуры

&НаКлиенте
Функция HostBatchSelect(Значение, Пути)

    Если Пути.Количество() = 0 Тогда Возврат Значение; КонецЕсли;
    Выборка = Новый Массив;
    Для Каждого Путь Из Пути Цикл
        Текущее = Значение;
        Для Каждого Часть Из СтрРазделить(Путь, ".") Цикл
            Если ТипЗнч(Текущее) = Тип("Массив") Тогда
                Индекс = Число(Часть);
                Если Индекс < 0 Или Индекс <> Цел(Индекс) Или Индекс >= Текущее.Количество() Тогда
                    ВызватьИсключение НСтр("ru = 'Индекс вне границ результата'; en = 'Result index out of bounds'");
                КонецЕсли;
                Текущее = Текущее[Индекс];
            Иначе
                Следующее = Неопределено;
                Если Не Текущее.Свойство(Часть, Следующее) Тогда
                    ВызватьИсключение НСтр("ru = 'Путь отсутствует в результате'; en = 'Result path is missing'");
                КонецЕсли;
                Текущее = Следующее;
            КонецЕсли;
        КонецЦикла;
        Выборка.Добавить(Новый Структура("path,value", Путь, Текущее));
    КонецЦикла;
    Возврат Выборка;

КонецФункции

&НаКлиенте
Процедура HostBatchFinish(Успех, Ошибка, ИсходНеизвестен = Ложь)

    Ответ = Новый Структура("request_id,success", АгентПакет.request_id, Успех);
    Ответ.Вставить("value", АгентРезультаты);
    Ответ.Вставить("outcome_unknown", ИсходНеизвестен);
    Если Не Успех Тогда Ответ.Вставить("error", Ошибка); КонецЕсли;
    // Freeze the terminal state before serialization or transport. No later business step may run.
    АгентПакет = Неопределено;
    АгентПрогресс = Неопределено;
    Попытка
        АгентОтветПакета = HostWriteJSON(Ответ);
    Исключение
        Ответ.Удалить("value");
        Ответ.success = Ложь;
        Ответ.Вставить("error", "Batch result serialization failed; executed steps must not be replayed");
        АгентОтветПакета = HostWriteJSON(Ответ);
    КонецПопытки;
    HostBatchComplete();

КонецПроцедуры

&НаКлиенте
Процедура HostBatchComplete()
    HostRequireNativeReply(КомпонентаАгента.Complete(АгентОтветПакета), "{}", "Complete");
    АгентОтветПакета = Неопределено;
КонецПроцедуры

&НаКлиенте
Функция HostExecuteClient(ЗаданиеАгента)

    Ответ = Новый Структура("request_id,success", ЗаданиеАгента.request_id, Ложь);
    Попытка
        ПараметрыВызова = ЗаданиеАгента.parameters;
        Результат = Неопределено;
        Выполнить(ЗаданиеАгента.code);
        Ответ.Вставить("value", Результат);
        Ответ.success = Истина;
        Возврат HostWriteJSON(Ответ);
    Исключение
        Ответ.success = Ложь;
        Ответ.Удалить("value");
        Ответ.Вставить("error", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
        Возврат HostWriteJSON(Ответ);
    КонецПопытки;

КонецФункции

&НаСервереБезКонтекста
Функция HostExecuteServer(ТекстЗадания)

    ЗаданиеАгента = HostReadJSON(ТекстЗадания);
    Ответ = Новый Структура("request_id,success", ЗаданиеАгента.request_id, Ложь);
    Попытка
        ПараметрыВызова = ЗаданиеАгента.parameters;
        Результат = Неопределено;
        Выполнить(ЗаданиеАгента.code);
        Ответ.Вставить("value", Результат);
        Ответ.success = Истина;
        Возврат HostWriteJSON(Ответ);
    Исключение
        Ответ.success = Ложь;
        Ответ.Удалить("value");
        Ответ.Вставить("error", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
        Возврат HostWriteJSON(Ответ);
    КонецПопытки;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция HostReadJSON(ТекстJSON)
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(ТекстJSON);
    ЗначениеJSON = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат ЗначениеJSON;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция HostWriteJSON(ЗначениеJSON)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, ЗначениеJSON);
    Возврат Запись.Закрыть();
КонецФункции

&НаСервереБезКонтекста
Функция HostComponentAddress(ДанныеКомпоненты, ВладелецХранилища)
    Возврат ПоместитьВоВременноеХранилище(ДанныеКомпоненты, ВладелецХранилища);
КонецФункции

&НаКлиенте
Процедура HostStage(Этап)
    ТекстЭтапа = Новый ТекстовыйДокумент;
    ТекстЭтапа.УстановитьТекст(Этап);
    ТекстЭтапа.Записать(Сред(ПараметрЗапуска, СтрДлина("EDTAgentHost=") + 1) + ".stage", КодировкаТекста.UTF8);
КонецПроцедуры

#КонецОбласти
