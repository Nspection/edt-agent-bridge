// Fixed recipe: mark only a native-confirmed unchanged reference; never delete physically.
Если ТранзакцияАктивна() Тогда
    ВызватьИсключение НСтр("ru = 'Уборку тестовых данных нельзя начинать внутри чужой транзакции.'");
КонецЕсли;
МенеджерДанных = __MANAGER__.__NAME__;
СсылкаДанных = МенеджерДанных.ПолучитьСсылку(Новый УникальныйИдентификатор(ПараметрыВызова.uuid));
ЗапросДанных = Новый Запрос;
ЗапросДанных.Текст = "ВЫБРАТЬ Данные.Ссылка, Данные.ВерсияДанных, Данные.ПометкаУдаления ИЗ __TABLE__ КАК Данные ГДЕ Данные.Ссылка = &Ссылка";
ЗапросДанных.УстановитьПараметр("Ссылка", СсылкаДанных);
ОтветУборки = Новый Структура;
ОтветУборки.Вставить("protocol", "edt-test-data-cleanup-v1");
ОтветУборки.Вставить("cleanup_id", ПараметрыВызова.cleanup_id);
ОтветУборки.Вставить("nonce", ПараметрыВызова.nonce);
ОтветУборки.Вставить("record_id", ПараметрыВызова.record_id);
ОтветУборки.Вставить("uuid", ПараметрыВызова.uuid);
ОтветУборки.Вставить("expected_version", ПараметрыВызова.expected_version);
ОтветУборки.Вставить("outcome", "already_absent");
ЗаписьУборкиНачата = Ложь;
НачатьТранзакцию();
Попытка

    БлокировкаУборки = Новый БлокировкаДанных;
    ЭлементБлокировки = БлокировкаУборки.Добавить("__TABLE__");
    ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
    ЭлементБлокировки.УстановитьЗначение("Ссылка", СсылкаДанных);
    БлокировкаУборки.Заблокировать();
    ВыборкаДанных = ЗапросДанных.Выполнить().Выбрать();
    Если ВыборкаДанных.Следующий() Тогда
        ОтветУборки.outcome = "version_changed";
        Если ЗначениеВСтрокуВнутр(ВыборкаДанных.ВерсияДанных) = ПараметрыВызова.expected_version Тогда
            ОтветУборки.outcome = "mark_pending";
            ОбъектДанных = СсылкаДанных.ПолучитьОбъект();
            __SPECIAL_CHECK__
            Если ОбъектДанных.ПометкаУдаления Тогда ОтветУборки.outcome = "already_marked"; КонецЕсли;
            Если ОтветУборки.outcome = "mark_pending" Тогда
                ЗаписьУборкиНачата = Истина;
                ОбъектДанных.__MARK__;
                ВыборкаДанных = ЗапросДанных.Выполнить().Выбрать();
                Если НЕ ВыборкаДанных.Следующий() Тогда
                    ВызватьИсключение НСтр("ru = 'Объект исчез при установке пометки удаления.'");
                КонецЕсли;
                Если НЕ ВыборкаДанных.ПометкаУдаления Тогда
                    ВызватьИсключение НСтр("ru = 'Обработчик не установил пометку удаления.'");
                КонецЕсли;
                ВерсияПометки = ЗначениеВСтрокуВнутр(ВыборкаДанных.ВерсияДанных);
                ОтветУборки.outcome = "marked_for_deletion";
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;
    ЗафиксироватьТранзакцию();
    Если ТранзакцияАктивна() Тогда
        ВызватьИсключение НСтр("ru = 'Обработчик оставил вложенную транзакцию; уборка отменена.'");
    КонецЕсли;

Исключение

    Если ТранзакцияАктивна() Тогда
        ОтменитьТранзакцию();
        Если ЗаписьУборкиНачата Тогда
            ВыборкаОтката = ЗапросДанных.Выполнить().Выбрать();
            Если НЕ ВыборкаОтката.Следующий() Тогда
                ВызватьИсключение НСтр("ru = 'Объект отсутствует после отката уборки; исход требует проверки.'");
            КонецЕсли;
            Если ВыборкаОтката.ПометкаУдаления ИЛИ ЗначениеВСтрокуВнутр(ВыборкаОтката.ВерсияДанных) <> ПараметрыВызова.expected_version Тогда
                ВызватьИсключение НСтр("ru = 'Исходная версия не восстановлена после отката уборки; исход требует проверки.'");
            КонецЕсли;
        КонецЕсли;
        ОтветУборки.outcome = "rolled_back";
        ОтветУборки.Вставить("error", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    Иначе
        ВызватьИсключение;
    КонецЕсли;

КонецПопытки;
Если ОтветУборки.outcome = "marked_for_deletion" Тогда
    ВыборкаДанных = ЗапросДанных.Выполнить().Выбрать();
    Если НЕ ВыборкаДанных.Следующий() Тогда
        ВызватьИсключение НСтр("ru = 'Объект отсутствует после фиксации пометки; исход требует проверки.'");
    КонецЕсли;
    Если НЕ ВыборкаДанных.ПометкаУдаления ИЛИ ЗначениеВСтрокуВнутр(ВыборкаДанных.ВерсияДанных) <> ВерсияПометки Тогда
        ВызватьИсключение НСтр("ru = 'Объект изменился после фиксации пометки; исход требует проверки.'");
    КонецЕсли;
КонецЕсли;
Результат = ОтветУборки;
