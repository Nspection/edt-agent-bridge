// Fixed server recipe. UUID and nonce are persisted by the ledger before dispatch.
Если ТранзакцияАктивна() Тогда
    ВызватьИсключение НСтр("ru = 'Создание тестовых данных нельзя начинать внутри чужой транзакции.'");
КонецЕсли;
МенеджерДанных = __MANAGER__.__NAME__;
СсылкаДанных = МенеджерДанных.ПолучитьСсылку(Новый УникальныйИдентификатор(ПараметрыВызова.uuid));
ЗапросДанных = Новый Запрос;
ЗапросДанных.Текст = "ВЫБРАТЬ Данные.Ссылка, Данные.ВерсияДанных ИЗ __TABLE__ КАК Данные ГДЕ Данные.Ссылка = &Ссылка";
ЗапросДанных.УстановитьПараметр("Ссылка", СсылкаДанных);
СозданиеЗафиксировано = Ложь;
ОтветСоздания = Новый Структура;
ОтветСоздания.Вставить("protocol", "edt-test-data-create-v1");
ОтветСоздания.Вставить("creation_id", ПараметрыВызова.creation_id);
ОтветСоздания.Вставить("nonce", ПараметрыВызова.nonce);
ОтветСоздания.Вставить("metadata_fqn", ПараметрыВызова.metadata_fqn);
ОтветСоздания.Вставить("uuid", ПараметрыВызова.uuid);
ОтветСоздания.Вставить("created", Ложь);
НачатьТранзакцию();
Попытка

    БлокировкаСоздания = Новый БлокировкаДанных;
    ЭлементБлокировки = БлокировкаСоздания.Добавить("__TABLE__");
    ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
    ЭлементБлокировки.УстановитьЗначение("Ссылка", СсылкаДанных);
    БлокировкаСоздания.Заблокировать();
    Если НЕ ЗапросДанных.Выполнить().Пустой() Тогда
        ВызватьИсключение НСтр("ru = 'Зарезервированная ссылка уже существует; создание отменено.'");
    КонецЕсли;
    ОбъектДанных = МенеджерДанных.__FACTORY__();
    ОбъектДанных.УстановитьСсылкуНового(СсылкаДанных);
__ASSIGNMENTS__
    ОбъектДанных.__WRITE__;
    ВыборкаДанных = ЗапросДанных.Выполнить().Выбрать();
    Если НЕ ВыборкаДанных.Следующий() Тогда
        ВызватьИсключение НСтр("ru = 'Созданная ссылка не найдена в транзакции.'");
    КонецЕсли;
    ВерсияЗаписи = ЗначениеВСтрокуВнутр(ВыборкаДанных.ВерсияДанных);
    ЗафиксироватьТранзакцию();
    Если ТранзакцияАктивна() Тогда
        ВызватьИсключение НСтр("ru = 'Обработчик оставил вложенную транзакцию; создание отменено.'");
    КонецЕсли;
    СозданиеЗафиксировано = Истина;

Исключение

    Если ТранзакцияАктивна() Тогда
        ОтменитьТранзакцию();
        Если НЕ ЗапросДанных.Выполнить().Пустой() Тогда
            ВызватьИсключение НСтр("ru = 'Объект существует после отката; исход требует проверки.'");
        КонецЕсли;
        ОтветСоздания.Вставить("rolled_back", Истина);
        ОтветСоздания.Вставить("error", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
    Иначе
        ВызватьИсключение;
    КонецЕсли;

КонецПопытки;
Если СозданиеЗафиксировано Тогда
    ВыборкаДанных = ЗапросДанных.Выполнить().Выбрать();
    Если НЕ ВыборкаДанных.Следующий() Тогда
        ВызватьИсключение НСтр("ru = 'Записанный объект не найден после фиксации; исход требует проверки.'");
    КонецЕсли;
    Если ЗначениеВСтрокуВнутр(ВыборкаДанных.ВерсияДанных) <> ВерсияЗаписи Тогда
        ВызватьИсключение НСтр("ru = 'Версия объекта изменилась при подтверждении; исход требует проверки.'");
    КонецЕсли;
    ОтветСоздания.created = Истина;
    ОтветСоздания.Вставить("expected_version", ВерсияЗаписи);
КонецЕсли;
Результат = ОтветСоздания;
